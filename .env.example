# ===========================================================================
# .env.example — 환경변수 템플릿
# ---------------------------------------------------------------------------
# 사용법: 이 파일을 복사해 .env 로 만들고, 각 값을 실제 값으로 채운다.
#   (Windows PowerShell)  Copy-Item .env.example .env
#   (macOS / Linux)       cp .env.example .env
#
# ⚠️ .env 파일은 .gitignore로 git에서 제외된다. 절대 커밋하지 말 것.
# ⚠️ 이 .env.example 에는 실제 값을 적지 말 것 (placeholder만 유지).
# ===========================================================================

# --- weekly.py (주간 메일러) 필수 환경변수 -----------------------------------
# YouTube Data API v3 키 (Google Cloud Console에서 발급)
YOUTUBE_API_KEY=your_youtube_api_key_here

# 발송용 Gmail 주소
GMAIL_ADDRESS=your_gmail_address_here

# Gmail 앱 비밀번호 (16자리 영숫자 — 일반 비밀번호 아님)
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# 주간 리포트를 받을 메일 주소
RECIPIENT_EMAIL=your_recipient_email_here

# Claude API 키 (후보 AI 분석용 — weekly.py / benchmark.py 공용)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- benchmark.py (타 채널 벤치마크 모듈) 필수 환경변수 ----------------------
# Apify API 토큰 (벤치마크 모듈에서 외부 채널 Shorts 수집에 사용)
APIFY_TOKEN=your_apify_token_here

# --- 선택 환경변수 (weekly.py 실행 모드 제어 — 평소엔 설정 안 함) ------------
# 값을 1 로 설정하면 활성화. 평소엔 이 줄들을 주석 처리하거나 비워둔다.
# DRY_RUN=1          # 메일 발송 안 함 / history 미변경 / 미리보기 HTML만 저장
# FORCE_RESCAN=1     # 오늘자 history 무시하고 새로 수집·분석
# RESEND_LATEST=1    # 최신 history를 수집·분석 없이 메일만 재발송

# ===========================================================================
# 참고: GitHub Actions 시크릿 (레포 Settings → Secrets and variables → Actions)
# ---------------------------------------------------------------------------
# weekly.yml 이 사용하는 시크릿:
#   YOUTUBE_API_KEY, GMAIL_ADDRESS, GMAIL_APP_PASSWORD,
#   RECIPIENT_EMAIL, ANTHROPIC_API_KEY
#
# resend.yml 이 사용하는 시크릿:
#   GMAIL_ADDRESS, GMAIL_APP_PASSWORD, RECIPIENT_EMAIL_SELF,
#   YOUTUBE_API_KEY, ANTHROPIC_API_KEY
#   → RECIPIENT_EMAIL_SELF : 재발송 시 "본인에게만" 보내는 별도 수신 주소
#
# APIFY_TOKEN : benchmark.py 용. 전용 GitHub Actions 워크플로(benchmark.yml)는
#               아직 미작성 상태 → GitHub 시크릿 등록 여부는 [확인 필요].
# ===========================================================================
